# ============================================================
# FACILITA — DEPLOYMENT & PRODUCTION ENVIRONMENTS (.env.example)
# ============================================================

NODE_ENV=production
PORT=3333

# Database & Cache
DATABASE_URL="postgresql://user:password@localhost:5432/facilita?schema=public&sslmode=prefer"
REDIS_URL="redis://localhost:6379"

# Security & Secrets
JWT_SECRET="super-secret-jwt-key-replace-in-production"
PII_ENCRYPTION_KEY="32-byte-hex-key-for-aes-256-gcm-encryption"
PII_SALT="random-salt-string-for-sha256-hashing"

# Payment Gateway — Pagar.me
PAGARME_API_KEY="ak_test_xxxxxx"
PAGARME_RECIPIENT_ID="re_xxxxxx"
PAGARME_WEBHOOK_SECRET="wh_sec_xxxxxx"

# Real-Time Chat — Stream.io
STREAM_IO_API_KEY="stream_api_key_xxx"
STREAM_IO_API_SECRET="stream_api_secret_xxx"

# Background Check — Checagem.com
CHECAGEM_API_KEY="checagem_key_xxx"

# Biometric KYC — Truora
TRUORA_API_KEY="truora_key_xxx"

# Fraud Device Fingerprint — Fingerprint.com
FINGERPRINT_API_KEY="fingerprint_key_xxx"

# SMS Verification & Alerts — Twilio
TWILIO_ACCOUNT_SID="AC_xxx"
TWILIO_AUTH_TOKEN="twilio_auth_token_xxx"
TWILIO_FROM_NUMBER="+5511999999999"

# Object Storage — AWS S3 + KMS
AWS_REGION="us-east-1"
AWS_S3_BUCKET="facilita-uploads-prod"
AWS_KMS_KEY_ID="arn:aws:kms:us-east-1:123456789012:key/xxxx"
AWS_ACCESS_KEY_ID="AKIA_xxx"
AWS_SECRET_ACCESS_KEY="aws_secret_xxx"

# Frontend Apps URLs
NEXT_PUBLIC_API_URL="http://localhost:3333"
NEXT_PUBLIC_CLIENT_URL="http://localhost:3000"
