{
  "name": "facilita-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test --continue",
    "test:e2e": "turbo run test:e2e",
    "verify:prod": "node scripts/verify-production-readiness.js",
    "build:mobile:preview": "cd apps/provider && eas build --platform android --profile preview",
    "build:mobile:prod": "cd apps/provider && eas build --platform android --profile production",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "axios": "^1.16.0",
    "reflect-metadata": "^0.2.2"
  }
}
