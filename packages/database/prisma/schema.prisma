generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "catalog", "matching", "orders", "payments", "evidence", "fraud", "disputes", "analytics", "audit", "geo"]
}

// Geo Schema
model City {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  ibgeCode  String?  @unique
  state     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  neighborhoods Neighborhood[]
  categories    Category[]     @relation("CategoryToCity")

  @@schema("geo")
}

model Neighborhood {
  id        String   @id @default(uuid())
  cityId    String
  city      City     @relation(fields: [cityId], references: [id])
  name      String
  slug      String   @unique
  ibgeCode  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providerProfiles ProviderProfile[] @relation("ProviderToNeighborhood")

  @@schema("geo")
}

// Analytics Schema
model DailyMetric {
  date         DateTime @id
  gmv          BigInt   @default(0)
  ordersCount  Int      @default(0)
  matchesCount Int      @default(0)
  revenue      BigInt   @default(0)

  @@schema("analytics")
}

// Identity Schema
model User {
  id             String           @id @default(uuid())
  phone          String           @unique
  name           String?
  role           Role             @default(CUSTOMER)
  isVerified     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  profile        ProviderProfile?
  kycSubmissions KycSubmission[]
  devices        UserDevice[]

  @@schema("identity")
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN

  @@schema("identity")
}

model ProviderProfile {
  id                 String         @id @default(uuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id])
  cpfCnpj            String         @unique
  rating             Float          @default(5.0)
  isOnline           Boolean        @default(false)
  availableDays      Int[] // 0 = Sunday, 1 = Monday, etc.
  startHour          String // e.g., "08:00"
  endHour            String // e.g., "18:00"
  tier               ProviderTier   @default(BRONZE)
  pagarmeRecipientId String?        @unique
  isFlagged          Boolean        @default(false)
  fraudReason        String?
  bankCode           String?
  bankBranch         String?
  bankBranchDigit    String?
  bankAccount        String?
  bankAccountDigit   String?
  bankAccountType    String?
  bankDataHash       String?
  bankDataUpdatedAt  DateTime?
  serviceZones       Neighborhood[] @relation("ProviderToNeighborhood")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@schema("identity")
}

enum ProviderTier {
  BRONZE
  PRATA
  OURO

  @@schema("identity")
}

model KycSubmission {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  documentFrontUrl String
  documentBackUrl  String?
  selfieUrl        String
  status           KycStatus @default(PENDING)
  rejectionReason  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@schema("identity")
}

model UserDevice {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  pushToken String   @unique
  deviceId  String?
  platform  String?
  lastLogin DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@schema("identity")
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("identity")
}

// Order Schema
model Order {
  id          String      @id @default(uuid())
  userId      String
  providerId  String?
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @default(0.0)
  latitude    Float?
  longitude   Float?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  payments Payment[]
  evidence Evidence[]
  disputes Dispute[]

  @@schema("orders")
}

enum OrderStatus {
  PENDING
  MATCHED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  DONE
  CANCELED

  @@schema("orders")
}

// Catalog Schema (Existing models preserved...)
model Category {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  description  String?
  iconUrl      String?
  services     Service[]
  activeCities City[]    @relation("CategoryToCity")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@schema("catalog")
}

model Service {
  id              String   @id @default(uuid())
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  name            String
  description     String?
  basePrice       Decimal  @default(0.0)
  unitType        UnitType @default(FIXED)
  serviceCode     String? // LC 116 code
  cityServiceCode String? // Municipal code
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@schema("catalog")
}

enum UnitType {
  HOUR
  FIXED
  M2
  M3

  @@schema("catalog")
}

// Matching Schema
model ProviderLocation {
  id         String                                @id @default(uuid())
  providerId String                                @unique
  location   Unsupported("geography(Point, 4326)")
  updatedAt  DateTime                              @updatedAt

  @@schema("matching")
}

model ActiveProvider {
  id         String   @id @default(uuid())
  providerId String   @unique
  categoryId String
  isOnline   Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@schema("matching")
}

// Payments Schema
model Payment {
  id             String        @id @default(uuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id])
  externalId     String?       @unique // Pagar.me ID
  amount         Decimal
  splitAmount    Decimal? // Provider's share
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  transactionLog Json?
  ibsAmount      Decimal? // Reforma 2026
  cbsAmount      Decimal? // Reforma 2026
  invoiceId      String?       @unique
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@schema("payments")
}

enum PaymentMethod {
  CARD
  PIX

  @@schema("payments")
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  REFUNDED
  FAILED

  @@schema("payments")
}

model Wallet {
  id             String              @id @default(uuid())
  providerId     String              @unique
  balance        BigInt              @default(0) // Cents
  pendingBalance BigInt              @default(0) // Cents
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  transactions   WalletTransaction[]

  @@schema("payments")
}

model WalletTransaction {
  id          String          @id @default(uuid())
  walletId    String
  wallet      Wallet          @relation(fields: [walletId], references: [id])
  type        TransactionType
  amount      BigInt // Cents
  orderId     String?
  externalId  String? // Pagar.me transfer/charge ID
  description String?
  createdAt   DateTime        @default(now())

  @@schema("payments")
}

enum TransactionType {
  CREDIT // Release from escrow
  DEBIT // Payout/Withdrawal
  FROZEN // Entry into escrow (pending)
  CANCEL // Refund/Reversal

  @@schema("payments")
}

model Payout {
  id           String       @id @default(uuid())
  providerId   String
  amount       BigInt
  fee          BigInt       @default(0)
  status       PayoutStatus @default(PENDING)
  externalId   String?      @unique
  bankDataHash String?
  metadata     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@schema("payments")
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  PENDING_APPROVAL

  @@schema("payments")
}

// Evidence Schema
model Evidence {
  id        String       @id @default(uuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id])
  url       String
  type      EvidenceType
  metadata  Json? // EXIF data (GPS, Device, Timestamp)
  createdAt DateTime     @default(now())

  @@schema("evidence")
}

enum EvidenceType {
  BEFORE
  AFTER
  DURING
  DISPUTE

  @@schema("evidence")
}

// Disputes Schema
model Dispute {
  id          String        @id @default(uuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id])
  reason      String
  description String
  status      DisputeStatus @default(OPEN)
  outcome     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@schema("disputes")
}

enum DisputeStatus {
  OPEN
  RESOLVED
  CLOSED

  @@schema("disputes")
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String
  targetId  String
  action    String
  reason    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@schema("identity")
}

model Invoice {
  id          String   @id @default(uuid())
  orderId     String
  externalId  String?  @unique // eNotas ID
  status      String   @default("PENDING")
  xmlUrl      String?
  pdfUrl      String?
  totalAmount Decimal
  taxAmount   Decimal
  ibsAmount   Decimal?
  cbsAmount   Decimal?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payment Payment?

  @@schema("payments")
}

model FinancialAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorType  String // SYSTEM | ADMIN | OPERATOR
  action     String // PAYMENT_CAPTURED | PAYOUT_SCHEDULED | etc.
  entityType String // Payment | Wallet | Payout
  entityId   String
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@schema("audit")
}
