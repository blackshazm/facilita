generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "catalog", "matching", "orders", "payments", "evidence", "fraud", "disputes"]
}

// Identity Schema
model User {
  id             String           @id @default(uuid())
  phone          String           @unique
  name           String?
  role           Role             @default(CUSTOMER)
  isVerified     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  profile        ProviderProfile?
  kycSubmissions KycSubmission[]

  @@schema("identity")
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN

  @@schema("identity")
}

model ProviderProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  cpfCnpj       String   @unique
  rating        Float    @default(5.0)
  isOnline      Boolean  @default(false)
  availableDays Int[] // 0 = Sunday, 1 = Monday, etc.
  startHour     String // e.g., "08:00"
  endHour       String // e.g., "18:00"
  tier               ProviderTier @default(BRONZE)
  pagarmeRecipientId String?      @unique
  isFlagged          Boolean      @default(false)
  fraudReason        String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@schema("identity")
}

enum ProviderTier {
  BRONZE
  PRATA
  OURO

  @@schema("identity")
}

model KycSubmission {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  documentUrl String
  selfieUrl   String
  status      KycStatus @default(PENDING)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@schema("identity")
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("identity")
}

// Order Schema
model Order {
  id          String      @id @default(uuid())
  userId      String
  providerId  String?
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @default(0.0)
  latitude    Float?
  longitude   Float?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  payments    Payment[]
  evidence    Evidence[]
  disputes    Dispute[]

  @@schema("orders")
}

enum OrderStatus {
  PENDING
  MATCHED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  DONE
  CANCELED

  @@schema("orders")
}

// Catalog Schema (Existing models preserved...)
model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  iconUrl     String?
  services    Service[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@schema("catalog")
}

model Service {
  id          String    @id @default(uuid())
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  basePrice   Decimal   @default(0.0)
  unitType    UnitType  @default(FIXED)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@schema("catalog")
}

enum UnitType {
  HOUR
  FIXED
  M2
  M3

  @@schema("catalog")
}

// Matching Schema
model ProviderLocation {
  id         String                      @id @default(uuid())
  providerId String                      @unique
  location   Unsupported("geography(Point, 4326)")
  updatedAt  DateTime                    @updatedAt

  @@schema("matching")
}

model ActiveProvider {
  id         String   @id @default(uuid())
  providerId String   @unique
  categoryId String
  isOnline   Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@schema("matching")
}

// Payments Schema
model Payment {
  id            String        @id @default(uuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  externalId    String?       @unique // Pagar.me ID
  amount        Decimal
  splitAmount   Decimal?      // Provider's share
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionLog Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@schema("payments")
}

enum PaymentMethod {
  CARD
  PIX

  @@schema("payments")
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  REFUNDED
  FAILED

  @@schema("payments")
}

model Wallet {
  id             String              @id @default(uuid())
  providerId     String              @unique
  balance        BigInt              @default(0) // Cents
  pendingBalance BigInt              @default(0) // Cents
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  transactions   WalletTransaction[]

  @@schema("payments")
}

model WalletTransaction {
  id          String          @id @default(uuid())
  walletId    String
  wallet      Wallet          @relation(fields: [walletId], references: [id])
  type        TransactionType
  amount      BigInt // Cents
  orderId     String?
  externalId  String? // Pagar.me transfer/charge ID
  description String?
  createdAt   DateTime        @default(now())

  @@schema("payments")
}

enum TransactionType {
  CREDIT // Release from escrow
  DEBIT // Payout/Withdrawal
  FROZEN // Entry into escrow (pending)
  CANCEL // Refund/Reversal

  @@schema("payments")
}

// Evidence Schema
model Evidence {
  id        String       @id @default(uuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id])
  url       String
  type      EvidenceType
  metadata  Json?        // EXIF data (GPS, Device, Timestamp)
  createdAt DateTime     @default(now())

  @@schema("evidence")
}

enum EvidenceType {
  BEFORE
  AFTER
  DURING
  DISPUTE

  @@schema("evidence")
}

// Disputes Schema
model Dispute {
  id          String        @id @default(uuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id])
  reason      String
  description String
  status      DisputeStatus @default(OPEN)
  outcome     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@schema("disputes")
}

enum DisputeStatus {
  OPEN
  RESOLVED
  CLOSED

  @@schema("disputes")
}

