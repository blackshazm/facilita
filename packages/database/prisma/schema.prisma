generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["analytics", "audit", "catalog", "disputes", "evidence", "fraud", "geo", "identity", "matching", "orders", "payments"]
}

model City {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  ibgeCode      String?        @unique
  state         String
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  neighborhoods Neighborhood[]
  categories    Category[]     @relation("CategoryToCity")

  @@schema("geo")
}

model Neighborhood {
  id               String            @id @default(uuid())
  cityId           String
  name             String
  slug             String            @unique
  ibgeCode         String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  city             City              @relation(fields: [cityId], references: [id])
  providerProfiles ProviderProfile[] @relation("ProviderToNeighborhood")

  @@schema("geo")
}

model DailyMetric {
  date         DateTime @id
  gmv          BigInt   @default(0)
  ordersCount  Int      @default(0)
  matchesCount Int      @default(0)
  revenue      BigInt   @default(0)

  @@schema("analytics")
}

model User {
  id             String           @id @default(uuid())
  phone          String           @unique
  name           String?
  role           Role             @default(CUSTOMER)
  isVerified     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  inviteCode     String?          @unique
  invitedById    String?
  referralCount  Int              @default(0)
  referralLimit  Int              @default(200)
  kycSubmissions KycSubmission[]
  profile        ProviderProfile?
  invitedBy      User?            @relation("UserReferrals", fields: [invitedById], references: [id])
  referrals      User[]           @relation("UserReferrals")
  devices        UserDevice[]

  @@schema("identity")
}

model ProviderProfile {
  id                 String         @id @default(uuid())
  userId             String         @unique
  cpfCnpj            String         @unique
  rating             Float          @default(5.0)
  isOnline           Boolean        @default(false)
  availableDays      Int[]
  startHour          String
  endHour            String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  pagarmeRecipientId String?        @unique
  tier               ProviderTier   @default(BRONZE)
  fraudReason        String?
  isFlagged          Boolean        @default(false)
  bankAccount        String?
  bankAccountDigit   String?
  bankAccountType    String?
  bankBranch         String?
  bankBranchDigit    String?
  bankCode           String?
  bankDataHash       String?
  bankDataUpdatedAt  DateTime?
  user               User           @relation(fields: [userId], references: [id])
  serviceZones       Neighborhood[] @relation("ProviderToNeighborhood")

  @@schema("identity")
}

model KycSubmission {
  id               String    @id @default(uuid())
  userId           String
  selfieUrl        String
  status           KycStatus @default(PENDING)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  documentBackUrl  String?
  documentFrontUrl String
  rejectionReason  String?
  user             User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@schema("identity")
}

model UserDevice {
  id        String   @id @default(uuid())
  userId    String
  pushToken String   @unique
  deviceId  String?
  platform  String?
  lastLogin DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@schema("identity")
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  providerId  String?
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @default(0.0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  latitude    Float?
  longitude   Float?
  disputes    Dispute[]
  evidence    Evidence[]
  payments    Payment[]

  @@schema("orders")
}

model Category {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  description  String?
  iconUrl      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  services     Service[]
  activeCities City[]    @relation("CategoryToCity")

  @@schema("catalog")
}

model Service {
  id              String   @id @default(uuid())
  categoryId      String
  name            String
  description     String?
  basePrice       Decimal  @default(0.0)
  unitType        UnitType @default(FIXED)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  cityServiceCode String?
  serviceCode     String?
  category        Category @relation(fields: [categoryId], references: [id])

  @@schema("catalog")
}

model ProviderLocation {
  id         String                   @id @default(uuid())
  providerId String                   @unique
  location   Unsupported("geography")
  updatedAt  DateTime                 @updatedAt

  @@schema("matching")
}

model ActiveProvider {
  id         String   @id @default(uuid())
  providerId String   @unique
  categoryId String
  isOnline   Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@schema("matching")
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String
  externalId     String?       @unique
  amount         Decimal
  splitAmount    Decimal?
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  transactionLog Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  cbsAmount      Decimal?
  ibsAmount      Decimal?
  invoiceId      String?       @unique
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id])
  order          Order         @relation(fields: [orderId], references: [id])

  @@schema("payments")
}

model Wallet {
  id             String              @id @default(uuid())
  providerId     String              @unique
  balance        BigInt              @default(0)
  pendingBalance BigInt              @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  promoBalance   BigInt              @default(0)
  transactions   WalletTransaction[]

  @@schema("payments")
}

model WalletTransaction {
  id          String          @id @default(uuid())
  walletId    String
  type        TransactionType
  amount      BigInt
  orderId     String?
  externalId  String?
  description String?
  createdAt   DateTime        @default(now())
  wallet      Wallet          @relation(fields: [walletId], references: [id])

  @@schema("payments")
}
model PayoutBatch {
  id             String    @id @default(uuid())
  adminId        String
  totalAmount    BigInt
  totalCount     Int
  processedCount Int       @default(0)
  status         String
  errorMessage   String?
  lastHeartbeat  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  payouts        Payout[]

  @@schema("payments")
}

model Payout {
  id           String       @id @default(uuid())
  providerId   String
  amount       BigInt
  fee          BigInt       @default(0)
  status       PayoutStatus @default(PENDING)
  externalId   String?      @unique
  bankDataHash String?
  metadata     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  batchId      String?
  batch        PayoutBatch? @relation(fields: [batchId], references: [id])

  @@schema("payments")
}

model Evidence {
  id        String       @id @default(uuid())
  orderId   String
  url       String
  type      EvidenceType
  metadata  Json?
  createdAt DateTime     @default(now())
  order     Order        @relation(fields: [orderId], references: [id])

  @@schema("evidence")
}

model Dispute {
  id          String        @id @default(uuid())
  orderId     String
  reason      String
  description String
  status      DisputeStatus @default(OPEN)
  outcome     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  order       Order         @relation(fields: [orderId], references: [id])

  @@schema("disputes")
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String
  targetId  String
  action    String
  reason    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@schema("identity")
}

model Invoice {
  id          String   @id @default(uuid())
  orderId     String
  externalId  String?  @unique
  status      String   @default("PENDING")
  xmlUrl      String?
  pdfUrl      String?
  totalAmount Decimal
  taxAmount   Decimal
  ibsAmount   Decimal?
  cbsAmount   Decimal?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  payment     Payment?

  @@schema("payments")
}

model FinancialAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorType  String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@schema("audit")
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN

  @@schema("identity")
}

enum ProviderTier {
  BRONZE
  PRATA
  OURO

  @@schema("identity")
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("identity")
}

enum OrderStatus {
  PENDING
  MATCHED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  DONE
  CANCELED

  @@schema("orders")
}

enum UnitType {
  HOUR
  FIXED
  M2
  M3

  @@schema("catalog")
}

enum PaymentMethod {
  CARD
  PIX

  @@schema("payments")
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  REFUNDED
  FAILED

  @@schema("payments")
}

enum TransactionType {
  CREDIT
  DEBIT
  FROZEN
  CANCEL
  PROMO_CREDIT

  @@schema("payments")
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  PENDING_APPROVAL

  @@schema("payments")
}

enum EvidenceType {
  BEFORE
  AFTER
  DURING
  DISPUTE

  @@schema("evidence")
}

enum DisputeStatus {
  OPEN
  RESOLVED
  CLOSED

  @@schema("disputes")
}
