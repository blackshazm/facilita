# ==============================================================================
# 🚀 FACILITA — AMBIENTE DE PRODUÇÃO (.env.production.example)
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para '.env.production' no servidor de produção.
# 2. Nunca versione o arquivo final com valores reais no Git.
# 3. Gere segredos criptográficos fortes (mínimo 32 bytes hexadecimais).
# ==============================================================================

# --- [1. APLICAÇÃO & NÓ] ---
NODE_ENV=production
PORT=3333
API_BASE_URL="https://api.facilita.com.br"
FRONTEND_URL="https://app.facilita.com.br"
CORS_ORIGIN="https://app.facilita.com.br,https://admin.facilita.com.br"

# --- [2. BANCO DE DADOS & CACHE (DOCKER LOCAL)] ---
POSTGRES_USER=facilita_prod
POSTGRES_PASSWORD=GERE_UMA_SENHA_MUITO_FORTE_AQUI_123!
POSTGRES_DB=facilita_production
# String de conexão interna da rede Docker:
DATABASE_URL="postgresql://facilita_prod:GERE_UMA_SENHA_MUITO_FORTE_AQUI_123!@db:5432/facilita_production?schema=public&sslmode=prefer"
REDIS_URL="redis://redis:6379"

# --- [3. CRIPTOGRAFIA & SEGURANÇA (GERAR VIA `openssl rand -hex 32`)] ---
JWT_SECRET=GERE_UM_JWT_SECRET_ALEATORIO_COM_MAIS_DE_64_CARACTERES
PII_ENCRYPTION_KEY=GERE_UMA_CHAVE_HEX_DE_32_BYTES_EXATOS_PARA_AES_256_GCM
PII_SALT=GERE_UM_SALT_ALEATORIO_PARA_HASH_SHA256

# --- [4. GATEWAY DE PAGAMENTOS (PAGAR.ME V5)] ---
PAGARME_API_KEY="ak_live_SEU_TOKEN_DE_PRODUCAO_AQUI"
PAGARME_RECIPIENT_ID="re_SEU_RECEBEDOR_PADRAO_FACILITA"
PAGARME_WEBHOOK_SECRET="wh_sec_SEU_SEGREDO_DE_WEBHOOK_PAGARME"

# --- [5. EMISSÃO FISCAL (ENOTAS / GATEWAY NFSe)] ---
ENOTAS_API_KEY="SEU_TOKEN_ENOTAS_PRODUCAO"

# --- [6. CHAT EM TEMPO REAL (STREAM.IO)] ---
STREAM_IO_API_KEY="SEU_API_KEY_STREAM_PRODUCAO"
STREAM_IO_API_SECRET="SEU_SECRET_KEY_STREAM_PRODUCAO"

# --- [7. SEGURANÇA & KYC (TRUORA, CHECAGEM.COM & FINGERPRINT)] ---
CHECAGEM_API_KEY="SEU_TOKEN_CHECAGEM_COM"
TRUORA_API_KEY="SEU_TOKEN_TRUORA_PRODUCAO"
FINGERPRINT_API_KEY="SEU_TOKEN_FINGERPRINT_PRODUCAO"

# --- [8. COMUNICAÇÃO & SMS (TWILIO)] ---
TWILIO_ACCOUNT_SID="AC_SEU_ACCOUNT_SID_PRODUCAO"
TWILIO_AUTH_TOKEN="SEU_AUTH_TOKEN_PRODUCAO"
TWILIO_FROM_NUMBER="+5511999999999"

# --- [9. ARMAZENAMENTO DE ARQUIVOS (AWS S3 + KMS)] ---
AWS_REGION="us-east-1"
AWS_S3_BUCKET="facilita-documentos-producao"
AWS_KMS_KEY_ID="arn:aws:kms:us-east-1:000000000000:key/SEU_KMS_KEY_UUID"
AWS_ACCESS_KEY_ID="AKIA_SEU_ACCESS_KEY_PROD"
AWS_SECRET_ACCESS_KEY="SEU_SECRET_KEY_AWS_PROD"

# --- [10. OBSERVABILIDADE & MONITORAMENTO (GLITCHTIP / SENTRY & PROMETHEUS)] ---
# DSN apontando para a sua instância local do GlitchTip no servidor:
SENTRY_DSN="https://chave_publica@glitchtip.facilita.com.br/1"
NEXT_PUBLIC_SENTRY_DSN="https://chave_publica@glitchtip.facilita.com.br/2"
PROMETHEUS_METRICS_ENABLED=true

# --- [11. CLIENT FRONTEND (NEXT.JS 15 STANDALONE)] ---
NEXT_PUBLIC_API_URL="https://api.facilita.com.br"
NEXT_PUBLIC_CLIENT_URL="https://app.facilita.com.br"

# --- [12. DEPLOY AUTOMATIZADO & COOLIFY WEBHOOK (GITHUB ACTIONS SECRETS)] ---
# Webhook gerado no painel do Coolify para redeploy da API e do Client Web:
COOLIFY_WEBHOOK_API="https://painel.seu-servidor.com/api/v1/deploy?uuid=SEU_UUID_API&force=false"
COOLIFY_WEBHOOK_CLIENT="https://painel.seu-servidor.com/api/v1/deploy?uuid=SEU_UUID_CLIENT&force=false"
# Personal Access Token do GitHub para autenticar no GHCR (GitHub Container Registry):
GHCR_PAT="ghp_SEU_GITHUB_PERSONAL_ACCESS_TOKEN_COM_READ_WRITE_PACKAGES"
